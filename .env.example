# Copy to .env (or .env.local) for local development. Never commit real secrets.

NODE_ENV=development
PORT=3000

# Local Docker MongoDB (see docker-compose.yml) or an Azure DocumentDB connection string:
# mongodb+srv://<user>:<password>@<cluster>.mongocluster.cosmos.azure.com/?tls=true&authMechanism=SCRAM-SHA-256&retrywrites=false&maxIdleTimeMS=120000
MONGODB_URI=mongodb://localhost:27017
MONGO_DB_NAME=doraemon

# At least 32 characters. Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN_SECONDS=604800

WECHAT_APP_ID=wx0000000000000000
WECHAT_APP_SECRET=replace-me
WECHAT_API_TIMEOUT_MS=5000

SWAGGER_ENABLED=true